rules_version = '2';

// Toutes les données passent par le backend (Firebase Admin SDK), qui
// contourne ces règles. On bloque donc tout accès direct depuis le
// frontend/client pour éviter que quelqu'un lise/écrive Firestore
// en contournant l'API et ses contrôles de rôle (requireAuth/requireRole).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
