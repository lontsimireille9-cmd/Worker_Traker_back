# Port HTTP du backend
PORT=5000

# URL autorisée par CORS en développement
CLIENT_URL=http://localhost:5173

# Fuseau horaire utilisé pour les journées Daily Life
DEFAULT_TIME_ZONE=Africa/Douala

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=ton-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ton-project-id.iam.gserviceaccount.com

# Copie la valeur "private_key" du JSON du compte de service.
# Dans .env, les retours à la ligne doivent être écrits sous forme de \\n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nTON_CONTENU\\n-----END PRIVATE KEY-----\\n"
